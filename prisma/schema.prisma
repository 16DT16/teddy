generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  NEW
  RECEIVED
  PREPARING
  DELIVERED
  CANCELLED
}

enum SessionStatus {
  OPEN
  CLOSED
}

model Gojo {
  id          String   @id @default(cuid())
  number      Int      @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]
  dayGojos    DayGojo[]
}

model Product {
  id        String   @id @default(cuid())
  name      String
  category  String
  price     Decimal  @db.Decimal(10, 2)
  unit      String   @default("item")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
}

model DaySession {
  id               String        @id @default(cuid())
  businessDate     DateTime      @unique
  status           SessionStatus @default(OPEN)
  defaultSeatPrice Decimal       @default(0) @db.Decimal(10, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orders           Order[]
  dayGojos         DayGojo[]
}

model DayGojo {
  id          String   @id @default(cuid())
  sessionId   String
  gojoId      String
  peopleCount Int      @default(0)
  seatPrice   Decimal  @default(0) @db.Decimal(10, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  session     DaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gojo        Gojo       @relation(fields: [gojoId], references: [id], onDelete: Cascade)

  @@unique([sessionId, gojoId])
  @@index([sessionId])
  @@index([gojoId])
}

model Order {
  id           String      @id @default(cuid())
  sessionId    String
  gojoId       String
  productId    String
  quantity     Int
  customerText String?
  status       OrderStatus @default(NEW)
  unitPrice    Decimal     @db.Decimal(10, 2)
  totalPrice   Decimal     @db.Decimal(10, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  session      DaySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gojo         Gojo        @relation(fields: [gojoId], references: [id])
  product      Product     @relation(fields: [productId], references: [id])

  @@index([sessionId, gojoId])
  @@index([productId])
  @@index([status])
  @@index([createdAt])
}


model StaffAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}